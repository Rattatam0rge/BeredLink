@* Søk etter adresse, sted eller postnummer (Kartverkets åpne API-er via Geonorge). *@
<form id="search-form" class="fm-search" role="search" autocomplete="off">
  <label for="search-input" class="visually-hidden">Søk etter adresse, sted eller postnummer</label>
  <div class="fm-search-pill">
    <input id="search-input" type="search" class="fm-search-input" placeholder="Søk adresse, sted eller postnummer"
           role="combobox" aria-autocomplete="list" aria-controls="search-results" aria-expanded="false" />
    <button class="fm-search-btn" type="submit" aria-label="Søk">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.5"/><path d="M10 10l4.5 4.5"/></svg>
    </button>
  </div>
  <ul id="search-results" class="list-group fm-search-results shadow" role="listbox" hidden></ul>
</form>
