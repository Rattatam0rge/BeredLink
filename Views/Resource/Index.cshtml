@using FeedbackMap.Models
@model FeedbackMap.ViewModels.ResourceIndexViewModel
@{
    ViewData["Title"] = Model.IsProvider ? "Mine ressurser" : "Tilgjengelige ressurser";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">@ViewData["Title"]</h1>
  <div class="d-flex flex-wrap gap-2">
    @if (Model.IsProvider)
    {
      <a class="btn btn-success btn-lg" href="/?register=1">+ Registrer ressurs</a>
    }
    else
    {
      <a class="btn btn-outline-dark btn-lg" asp-action="Print" target="_blank" rel="noopener">Utskriftsvennlig liste</a>
    }
  </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
      @(Model.IsProvider ? "Du har ikke registrert noen ressurser ennå." : "Ingen tilgjengelige ressurser akkurat nå.")
    </div>
}
else
{
    <div class="table-responsive">
      <table class="table table-hover align-middle table-stack">
        <thead>
          <tr>
            <th>Bilde</th>
            <th>Type</th>
            <th>Status</th>
            <th>Tilgjengelig</th>
            @if (!Model.IsProvider) { <th>Leverandør</th><th>Kontakt</th> }
            <th></th>
          </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Items)
        {
          <tr>
            <td data-label="Bilde">
              @if (r.HasImage)
              {
                <a href="/Media/ResourceImage/@r.Id" target="_blank" rel="noopener">
                  <img class="res-thumb" src="/Media/ResourceImage/@r.Id" alt="Bilde av @r.Type" loading="lazy" />
                </a>
              }
              else { <span class="text-body-secondary">–</span> }
            </td>
            <td data-label="Type">
              <strong>@r.Type</strong>
              @if (!string.IsNullOrWhiteSpace(r.Description)) { <div class="small text-body-secondary">@r.Description</div> }
            </td>
            <td data-label="Status">
              @if (r.IsAssigned) { <span class="badge text-bg-dark">Tildelt behov</span> }
              else { <span class="badge text-bg-success">@Labels.Resource(r.Status)</span> }
            </td>
            <td data-label="Tilgjengelig">
              @Labels.Date(r.AvailableFrom)
              @if (r.AvailableTo is not null) { <text> – @Labels.Date(r.AvailableTo.Value)</text> }
            </td>
            @if (!Model.IsProvider)
            {
              <td data-label="Leverandør">@Labels.Provider(r.ProviderType)</td>
              <td data-label="Kontakt">@r.Phone<br />@r.Email</td>
            }
            <td data-label="" class="text-end cell-actions">
              <a class="btn btn-outline-primary" href="/?lat=@r.Latitude.ToString(inv)&lng=@r.Longitude.ToString(inv)&z=14">Kart</a>
              @if (Model.IsProvider)
              {
                <a class="btn btn-outline-dark" href="/?edit=@r.Id">Endre</a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                      data-confirm="Fjerne denne ressursen?">
                  <button type="submit" class="btn btn-outline-danger">Fjern</button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
}
